# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
DIRECT_URL="postgresql://user:password@localhost:5432/mydb"

# Supabase API Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Vercel Cron Security Secret (SEC-05)
CRON_SECRET="generate-a-secure-random-secret"

# Supabase Service Role Key (optional, for backend admin operations)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
